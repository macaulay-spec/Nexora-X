# Optional when frontend and backend are deployed separately.
# Example: VITE_SOCKET_URL=https://midnight-vote-api.onrender.com
VITE_SOCKET_URL=

# Optional backend CORS allowlist when deployed separately.
# Example: CLIENT_ORIGIN=https://midnight-vote.vercel.app
CLIENT_ORIGIN=

# Backend port. Most hosts inject this automatically.
PORT=5173
